[Unit]
Description=GLM-5.3-Flash + built-in MTP nextn drafter (A/B test, port 8100)
After=network.target cpu-governor.service

[Service]
TimeoutStopSec=300
LimitMEMLOCK=infinity
Type=simple
User=user001
WorkingDirectory=/mnt/ollama/models/llama-cpp-glm5

ExecStart=/mnt/ollama/models/llama-cpp-glm5/build/bin/llama-server \
  -m /mnt/ollama/models/glm-5.3-flash/UD-IQ4_XS/GLM-5.3-Flash-UD-IQ4_XS-00001-of-00005.gguf \
  --spec-type draft-mtp \
  --spec-draft-n-max 4 \
  --alias unsloth/glm-5.3-flash-mtp \
  --host 0.0.0.0 --port 8100 \
  --threads -1 --numa distribute --load-mode mlock \
  --parallel 1 --ctx-size 131072 --flash-attn on \
  --cache-type-k f16 --cache-type-v f16 \
  --batch-size 2048 --ubatch-size 512 \
  --cont-batching \
  --cache-prompt --cache-reuse 1024 \
  --metrics --verbose --jinja \
  --fit on \
  --reasoning-effort max \
  --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.01 \
  --repeat-penalty 1.05 \
  --no-context-shift

Restart=on-failure
RestartSec=10s
